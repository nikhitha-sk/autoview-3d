# Copy to .env.local and fill in what you have. Everything is optional:
# with no keys, Photo -> 3D runs in demo mode (procedural model tinted from your photo).

# Image -> 3D (first one set wins)
TRIPO_API_KEY=
MESHY_API_KEY=

# Car recognition (Google AI Studio key)
GEMINI_API_KEY=
# Optional; falls back to the gemini-flash-latest alias
GEMINI_MODEL=

# Cloudflare R2 storage for generated .glb files (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Comma-separated hosts /api/model may stream from
MODEL_PROXY_HOSTS=tripo3d.ai,tripo3d.com,meshy.ai,bcebos.com

# Used for absolute URLs in metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
